# Copy to .env and fill in. The real .env is gitignored.

# Required for live LLM chat. The server still boots without it; only real
# chat calls fail (with a clear error). Not needed when LLM_MOCK=true.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# If empty, the built-in market simulator is used (recommended for most users).
MASSIVE_API_KEY=

# Optional: set to "true" for deterministic mock LLM responses (used by E2E tests).
LLM_MOCK=false
